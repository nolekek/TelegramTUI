{
  "_about": "Design tokens for TgTui (Telegram Desktop rebuild for terminal). Tokens map to semantic roles (what each colour and style does). Checked with WCAG 2.2 AA contrast rules via contrast.py.",
  "color": {
    "bg": "#0e1621",
    "surface": "#182533",
    "surface-hover": "#202f3d",
    "border": "#283a4f",
    "border-input": "#5ba2f4",
    "text": "#f8fafc",
    "text-muted": "#b8cbdb",
    "accent": "#5ba2f4",
    "on-accent": "#0e1621",
    "danger": "#f87171",
    "success": "#4ade80",
    "warning": "#fbbf24"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"],
    ["accent", "bg"],
    ["danger", "bg"],
    ["success", "bg"],
    ["warning", "bg"],
    ["border-input", "bg", "ui"]
  ],
  "font": {
    "sans": "JetBrains Mono, Fira Code, Cascadia Code, ui-monospace, monospace",
    "mono": "JetBrains Mono, Menlo, Consolas, monospace"
  },
  "type": {
    "xs": {"size": 11, "line": 14, "weight": 400},
    "sm": {"size": 13, "line": 18, "weight": 400},
    "base": {"size": 15, "line": 22, "weight": 400},
    "lg": {"size": 18, "line": 26, "weight": 600},
    "xl": {"size": 24, "line": 32, "weight": 700},
    "display": {"size": 32, "line": 38, "weight": 700}
  },
  "space": [0, 1, 2, 3, 4, 6, 8, 12, 16],
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 4,
    "lg": 8,
    "pill": 999
  },
  "shadow": {
    "card": "0 2px 4px rgba(0,0,0,.4)",
    "pop": "0 10px 25px rgba(0,0,0,.6)"
  },
  "motion": {
    "fast": "100ms",
    "base": "150ms",
    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "terminal": {
    "borders": {
      "single": {"tl": "┌", "tr": "┐", "bl": "└", "br": "┘", "h": "─", "v": "│"},
      "rounded": {"tl": "╭", "tr": "╮", "bl": "╰", "br": "╯", "h": "─", "v": "│"},
      "double": {"tl": "╔", "tr": "╗", "bl": "╚", "br": "╝", "h": "═", "v": "║"},
      "block": {"tl": "█", "tr": "█", "bl": "█", "br": "█", "h": "▀", "v": "▌"}
    },
    "ansi16": {
      "bg": "black",
      "surface": "dark_gray",
      "border": "gray",
      "text": "white",
      "text_muted": "gray",
      "accent": "cyan",
      "on_accent": "black",
      "danger": "red",
      "success": "green",
      "warning": "yellow"
    }
  }
}
