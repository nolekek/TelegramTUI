# Telegram MTProto API Credentials
# Obtain your own api_id and api_hash from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Optional local database encryption key (passphrase for TDLib SQLite database encryption)
TG_DATABASE_ENCRYPTION_KEY=

# Optional default phone number for authentication prompt
TG_PHONE_NUMBER=

# Optional path to TDLib dynamic library (defaults to system PATH or relative directory)
# Windows: libtdjson.dll, Linux: libtdjson.so, macOS: libtdjson.dylib
TG_TDLIB_PATH=
